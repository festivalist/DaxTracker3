{
  "inputs": [
    {
      "type": "promptString", 
      "id": "telegram-token",
      "description": "Telegram Bot Token",
      "password": true
    },
    {
      "type": "promptString",
      "id": "telegram-chat-id", 
      "description": "Telegram Chat ID"
    }
  ],  "servers": {
    "TradingSignals": {
      "type": "stdio",
      "command": "${workspaceFolder}/trading_env/Scripts/python.exe",
      "args": ["${workspaceFolder}/trading_signal_server_new.py"],
      "env": {
        "TELEGRAM_TOKEN": "${input:telegram-token}",
        "TELEGRAM_CHAT_ID": "${input:telegram-chat-id}",
        "DB_PATH": "${workspaceFolder}/market_data.db"
      }
    },
    "my-mcp-server-a0c53f27": {
      "type": "stdio",
      "command": "${workspaceFolder}/trading_env/Scripts/python.exe",
      "args": ["${workspaceFolder}/trading_signal_server_new.py"],
      "env": {
        "DB_PATH": "${workspaceFolder}/market_data.db"
      }
    }
  }
}
